# Cloudflare headers (Workers static assets and Pages both read this file).
# https://developers.cloudflare.com/workers/static-assets/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

# The service worker and manifest must always be revalidated so updates roll out.
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache

# Rarely-changing binary assets can be cached by the browser for a week.
# (The service worker's own cache handles offline use and versioning.)
/fonts/*
  Cache-Control: public, max-age=604800

/icons/*
  Cache-Control: public, max-age=604800
